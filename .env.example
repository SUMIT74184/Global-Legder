# Copy to .env. Used by docker-compose.yml (Postgres) and the Astro site. cms/ has its own .env.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ledger

# Astro site: where the Payload CMS runs
PAYLOAD_URL=http://localhost:3000

# Umami analytics (docker compose service at http://localhost:3001)
UMAMI_APP_SECRET=generate-with-openssl-rand-hex-32
# After adding the site in Umami: script URL and website ID. Leave empty to turn analytics off.
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
