---
import { langOf, t, typeInfo } from '../lib/i18n';

const KINDS = {
  research: { label: 'Research', cls: 'stamp-ink' },
  'case-study': { label: 'Case study', cls: '' },
  report: { label: 'Financial report', cls: 'stamp-gold' },
  data: { label: 'Open data', cls: 'stamp-good' },
  updated: { label: 'Updated', cls: 'stamp-bad' },
} as const;

interface Props {
  kind: keyof typeof KINDS;
  label?: string;
  tilt?: number;
}

const { kind, label, tilt = -4 } = Astro.props;
const k = KINDS[kind];
const lang = langOf(Astro);
const fallback = kind === 'data' || kind === 'updated' ? t(lang).stamps[kind] : typeInfo(lang, kind).label;
---

<span class:list={['stamp', k.cls]} style={`--tilt:${tilt}deg`} data-reveal="stamp">{label ?? fallback}</span>
