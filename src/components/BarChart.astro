---
// Horizontal bar chart drawn at build time from a CSV (one row per bar). Bars grow in when the
// chart scrolls into view; one bar can be picked out in clay. The numbers sit in a table below.
import { findColumn, loadCsv, niceTicks, hashId, toNumber } from '../lib/chart';
import ChartProblem from './ChartProblem.astro';
import { formatNumber, langOf, t } from '../lib/i18n';

interface Props {
  csv: string;
  x: string; // label column
  y: string; // value column
  title: string;
  unit?: string;
  sort?: 'desc' | 'none';
  highlight?: string;
  source: string;
  sourceUrl?: string;
  note?: string;
}

const { csv, x, y, title = '', unit = '', sort = 'desc', highlight, source = '', sourceUrl, note } = Astro.props;
const lang = langOf(Astro);
const tr = t(lang);
const data = await loadCsv(csv);
const xCol = findColumn(data.headers, x);
const yCol = findColumn(data.headers, y);
const rows = xCol && yCol ? data.rows.map((r) => ({ label: r[xCol], value: toNumber(r[yCol]) })).filter((r) => r.label && Number.isFinite(r.value)) : [];
if (sort === 'desc') rows.sort((a, b) => b.value - a.value);

const max = Math.max(0, ...rows.map((r) => r.value));
const min = Math.min(0, ...rows.map((r) => r.value));
const ticks = niceTicks(min, max, 4);
const lo = ticks[0];
const hi = ticks[ticks.length - 1];
const W = 640;
const labelW = 150;
const bar = 22;
const gap = 12;
const H = rows.length * (bar + gap) + 26;
const sx = (v: number) => labelW + ((v - lo) / (hi - lo || 1)) * (W - labelW - 70);
const id = `b${hashId(title || csv)}`;
const fmt = (v: number) => formatNumber(v, lang);
const mark = highlight?.trim().toLowerCase();
---

{!xCol || !yCol || rows.length === 0 ? (
  <ChartProblem title={title} headers={data.headers} missing={[!xCol && x, !yCol && y].filter(Boolean) as string[]} />
) : (
<figure class="chart not-prose" data-sketch="fill" data-sketch-r="12" data-reveal>
  <figcaption class="mb-3">
    <p class="font-sans text-base font-semibold text-ink">{title}</p>
    {unit && <p class="font-sans text-xs text-mute">{unit}</p>}
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full overflow-visible" role="img" aria-labelledby={`${id}-t`}>
    <title id={`${id}-t`}>{title}. {tr.chart.source}: {source}.</title>
    <g class="chart-grid">
      {ticks.map((v) => <line x1={sx(v)} x2={sx(v)} y1="0" y2={H - 22} />)}
    </g>
    <g class="chart-axis">
      {ticks.map((v) => <text x={sx(v)} y={H - 4} text-anchor="middle">{fmt(v)}</text>)}
    </g>
    {
      rows.map((r, i) => {
        const top = i * (bar + gap);
        const x0 = sx(Math.min(0, r.value));
        const w = Math.max(1.5, Math.abs(sx(r.value) - sx(0)));
        const hot = mark && r.label.trim().toLowerCase() === mark;
        return (
          <g class:list={['bar-row', { 'is-hot': hot }]} style={`--i:${i}`}>
            <text class="bar-label" x={labelW - 10} y={top + bar / 2 + 5} text-anchor="end">{r.label}</text>
            <rect class="bar" x={x0} y={top} width={w} height={bar} rx="3" style={`transform-origin:${sx(0)}px 0`} />
            <text class="bar-value" x={x0 + w + 6} y={top + bar / 2 + 5}>{fmt(r.value)}</text>
          </g>
        );
      })
    }
  </svg>
  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-sans text-xs text-mute">
    <span>{tr.chart.source}: {sourceUrl ? <a class="underline decoration-dotted underline-offset-2 hover:text-clay-d" href={sourceUrl}>{source}</a> : source}</span>
    <a class="font-semibold text-clay-d hover:underline" href={csv} download>{tr.chart.download}</a>
  </div>
  {note && <p class="mt-1 font-sans text-xs text-mute">{note}</p>}
  <details class="mt-2 font-sans text-xs text-ink-2">
    <summary class="cursor-pointer text-mute hover:text-ink">{tr.chart.numbers}</summary>
    <table class="mt-2 w-full max-w-xs">
      <thead><tr><th class="py-1 text-left">{x}</th><th class="py-1 text-right">{y}</th></tr></thead>
      <tbody>{rows.map((r) => <tr class="border-t border-rule"><td class="py-0.5">{r.label}</td><td class="py-0.5 text-right tabular-nums">{fmt(r.value)}</td></tr>)}</tbody>
    </table>
  </details>
</figure>
)}
