---
// A run of dated events along a line that draws itself, dots popping in as it passes.
interface Props {
  title?: string;
  events: { date: string; title: string; text?: string }[];
}

const { title, events } = Astro.props;
---

<section class="timeline not-prose my-10" data-reveal>
  {title && <p class="mb-5 font-hand text-xl text-ink">{title}</p>}
  <div class="relative">
    <svg class="absolute left-[7px] top-1 h-[calc(100%-0.5rem)] w-2 overflow-visible" viewBox="0 0 8 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M4 0 C 6 25, 2 50, 4 75 S 5 95, 4 100" pathLength="1" data-draw style={`fill:none;stroke:var(--kraft);stroke-width:2.5;stroke-linecap:round;--draw-dur:${Math.min(2.4, 0.5 + events.length * 0.3)}s`}></path>
    </svg>
    <ol class="space-y-6">
      {
        events.map((e, i) => (
          <li class="relative pl-8">
            <span class="absolute left-0 top-1.5 h-4 w-4 rounded-full border-2 border-ink bg-card" data-after-draw style={`--after:${0.25 + i * 0.3}s`} />
            <p class="font-hand text-base text-clay-d">{e.date}</p>
            <p class="font-sans font-semibold text-ink">{e.title}</p>
            {e.text && <p class="mt-0.5 font-sans text-sm leading-relaxed text-ink-2">{e.text}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>
