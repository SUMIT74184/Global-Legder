---
// Map with places and routes (OpenFreeMap tiles, recoloured to the site's paper palette). The
// map loads only when it nears the screen; routes draw themselves, then the places pop in.
// Without JS (or before load) the places are listed as text.
import { langOf, t } from '../lib/i18n';

export interface MapPlace {
  name: string;
  lat: number;
  lng: number;
  kind?: 'point' | 'key' | 'event';
  note?: string;
}

export interface MapRoute {
  label?: string;
  colour?: string;
  dashed?: boolean;
  path: [number, number][]; // [lat, lng]
}

interface Props {
  title: string;
  places: MapPlace[];
  routes: MapRoute[];
  source?: string;
  caption?: string;
  height?: 'sm' | 'md' | 'lg';
}

const { title, places, routes, source, caption, height = 'md' } = Astro.props;
const tr = t(langOf(Astro));
const config = { places, routes };
---

<figure class="map-block not-prose" data-sketch="fill" data-sketch-r="12" data-reveal>
  <figcaption class="mb-3">
    <p class="font-sans text-base font-semibold text-ink">{title}</p>
  </figcaption>
  <div class:list={['map-canvas', `map-${height}`]} data-map aria-label={title} role="region">
    <script type="application/json" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />
    <span class="map-loading">{tr.map.loading}</span>
  </div>
  {
    routes.some((r) => r.label) && (
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-sans text-xs text-ink-2" aria-label={tr.map.routes}>
        {routes.filter((r) => r.label).map((r) => (
          <li class="flex items-center gap-1.5">
            <span class="inline-block h-0.5 w-5 rounded" style={`background:var(--${r.colour ?? 'clay'})`} />
            {r.label}
          </li>
        ))}
      </ul>
    )
  }
  {(caption || source) && (
    <p class="mt-2 font-sans text-xs text-mute">
      {caption}{caption && source && ' · '}{source && <>{tr.map.source}: {source}</>}
    </p>
  )}
  {
    places.length > 0 && (
      <details class="mt-2 font-sans text-xs text-ink-2">
        <summary class="cursor-pointer text-mute hover:text-ink">{tr.map.places}</summary>
        <ul class="mt-2 space-y-1">
          {places.map((p) => (
            <li><span class="font-semibold text-ink">{p.name}</span>{p.note && <> · {p.note}</>}</li>
          ))}
        </ul>
      </details>
    )
  }
</figure>
