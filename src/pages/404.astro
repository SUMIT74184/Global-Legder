---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stamp from '../components/Stamp.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center">
    <Stamp kind="updated" label="Not on the ledger" tilt={-6} />
    <h1 class="mt-8 font-serif text-4xl font-semibold text-ink">This page isn't here.</h1>
    <p class="mt-3 text-ink-2">It may have moved, or the link has a typo.</p>
    <a href="/" class="btn btn-primary mt-8" data-sketch="fill">Back to the front page</a>
  </section>
</BaseLayout>
